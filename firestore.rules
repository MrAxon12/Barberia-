rules_version = '2';

/*
  BLACK CROWN — Reglas de seguridad de Firestore
  Pégalas en: Firebase Console > Firestore Database > Reglas > Publicar

  Principios:
  - El público NUNCA puede leer citas (nombre/teléfono de clientes).
  - La disponibilidad pública se lee de "ocupados" (sin datos personales).
  - Una cita y sus horarios se crean en un solo lote (batch) y los horarios
    solo pueden crearse una vez => imposible reservar dos veces el mismo hueco.
  - Solo personal activo (owner / barbero) puede ver y gestionar citas.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isOwner() {
      return signedIn() && profile().rol == 'owner' && profile().activo == true;
    }

    function isBarber() {
      return signedIn() && profile().rol == 'barbero' && profile().activo == true;
    }

    function validService(d) {
      return d.keys().hasOnly(['name', 'price', 'duration', 'active'])
        && d.keys().hasAll(['name', 'price', 'duration', 'active'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.price is number && d.price >= 0 && d.price <= 100000
        && d.duration is int && d.duration >= 5 && d.duration <= 180
        && d.active is bool;
    }

    function validCita(d) {
      let svc = get(/databases/$(database)/documents/servicios/$(d.serviceId)).data;
      let brb = get(/databases/$(database)/documents/barberos/$(d.workerId)).data;
      return d.keys().hasOnly(['name', 'phone', 'serviceId', 'service', 'date', 'time',
                               'duration', 'price', 'workerId', 'status',
                               'privacyAccepted', 'privacyVersion', 'slotIds',
                               'createdAt', 'deleteAfter'])
        && d.keys().hasAll(['name', 'phone', 'serviceId', 'service', 'date', 'time',
                            'duration', 'price', 'workerId', 'status',
                            'privacyAccepted', 'privacyVersion', 'slotIds',
                            'createdAt', 'deleteAfter'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.phone is string && d.phone.matches('^[0-9+() -]{8,20}$')
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.status == 'pending'
        && d.privacyAccepted == true
        && d.privacyVersion is string && d.privacyVersion.size() <= 20
        && d.slotIds is list && d.slotIds.size() >= 1 && d.slotIds.size() <= 12
        && d.createdAt == request.time
        && d.deleteAfter is timestamp
        // El precio, duración y nombre deben coincidir con el servicio real (anti-manipulación)
        && svc.active == true
        && svc.price == d.price
        && svc.duration == d.duration
        && svc.name == d.service
        // El barbero debe existir y estar activo
        && brb.activo == true;
    }

    // ---------- Perfiles internos (owner / barbero) ----------
    // Se crean SOLO desde Firebase Console o Cloud Functions (nunca desde el sitio).
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if false;
    }

    // ---------- Configuración (horarios, fechas bloqueadas) ----------
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ---------- Servicios ----------
    match /servicios/{id} {
      allow read: if resource.data.active == true || isOwner();
      allow create, update: if isOwner() && validService(request.resource.data);
      allow delete: if isOwner();
    }

    // ---------- Barberos (perfil público: solo nombre) ----------
    match /barberos/{id} {
      allow read: if resource.data.activo == true || isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['nombre', 'activo'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.activo is bool;
      allow delete: if isOwner();
    }

    // ---------- Citas (DATOS PERSONALES: nunca públicas) ----------
    match /citas/{id} {
      allow create: if validCita(request.resource.data);

      allow read: if isOwner()
        || (isBarber() && resource.data.workerId == request.auth.uid);

      // Solo se puede cambiar el estado (y la marca de actualización)
      allow update: if (isOwner() || (isBarber() && resource.data.workerId == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'confirmed', 'completed', 'cancelled'];

      // Derecho de cancelación / supresión de datos: solo el propietario
      allow delete: if isOwner();
    }

    // ---------- Horarios ocupados (sin datos personales) ----------
    match /ocupados/{slotId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['workerId', 'date', 'time', 'citaId', 'expireAt'])
        && request.resource.data.keys().hasAll(['workerId', 'date', 'time', 'citaId', 'expireAt'])
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.expireAt is timestamp
        && slotId == request.resource.data.workerId + '_' + request.resource.data.date + '_'
                     + request.resource.data.time.replace(':', '')
        // Solo se acepta si en el MISMO lote se crea la cita correspondiente
        && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.workerId == request.resource.data.workerId
        && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.date == request.resource.data.date
        && slotId in getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.slotIds;

      // Sin update: un horario ocupado no se puede pisar. Liberarlo = borrar (personal).
      allow delete: if isOwner() || (isBarber() && resource.data.workerId == request.auth.uid);
    }

    // Todo lo demás, bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
